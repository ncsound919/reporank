# ========================================
# REQUIRED — Database & Auth
# ========================================
# SQLite (local dev):  file:./reporank.db
# PostgreSQL (prod):   postgresql://postgres:postgres@localhost:5432/reporank
DATABASE_URL=file:./reporank.db
REDIS_URL=redis://localhost:6379
# ⚠️  Generate a strong JWT_SECRET for production: openssl rand -hex 32
# NEVER use the placeholder value in production.
JWT_SECRET=change-this-to-a-random-secret
JWT_EXPIRES_IN=7d

# ========================================
# REQUIRED — AI Provider
# ========================================
# Get your Gemini API key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ========================================
# OPTIONAL — GitHub OAuth
# ========================================
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_TOKEN=

# ========================================
# OPTIONAL — Stripe billing
# ========================================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=price_pro_monthly
STRIPE_PRICE_ENTERPRISE=price_enterprise_monthly

# ========================================
# Server
# ========================================
PORT=3001
APP_URL=http://localhost:5173
NODE_ENV=development
DEEP_SCAN=false
LOG_LEVEL=info

# Vendored audit scanner binaries (osv-scanner, syft, hadolint, trufflehog, squawk)
# Optional: dir checked ahead of PATH for audit tools; missing tools are excluded honestly.
AUDIT_TOOLS_DIR=/path/to/audit-tools

# ========================================
# OPTIONAL — OpenHub shared audit core
# ========================================
# When set, remote scans POST their findings to OpenHub's /api/audit-core/run
# for deterministic validation (reachability/staleness), lifecycle and
# PR/release gating. A core outage is logged and never fails the scan.
OPENHUB_CORE_URL=
OPENHUB_TOKEN=
