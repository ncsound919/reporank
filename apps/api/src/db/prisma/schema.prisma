generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url = env("DATABASE_URL")
}

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  displayName      String?
  firebaseUid      String?   @unique
  githubId         String?   @unique
  avatarUrl        String?
  tier             String    @default("free")
  scansThisMonth   Int       @default(0)
  stripeCustomerId String?
  createdAt        DateTime  @default(now())
  orgs             OrgMember[]
  apiKeys          ApiKey[]
  scans            Scan[]
  prConfigs        PrWebhookConfig[]
  projectBriefs    ProjectBrief[]
}

model Org {
  id                    String    @id @default(cuid())
  name                  String
  slug                  String    @unique
  plan                  String    @default("free")
  stripeSubscriptionId  String?
  stripePriceId         String?
  scanLimit             Int       @default(3)
  scansThisPeriod       Int       @default(0)
  periodStart           DateTime?
  periodEnd             DateTime?
  createdAt             DateTime  @default(now())
  members               OrgMember[]
  scans                 Scan[]
  clawAgents            ClawAgent[]
  clawAlerts            ClawAlert[]
  subscriptions         Subscription[]
  webhooks              Webhook[]
  projectBriefs         ProjectBrief[]
}

model OrgMember {
  id       String   @id @default(cuid())
  role     String   @default("member")
  joinedAt DateTime @default(now())
  orgId    String
  org      Org      @relation(fields: [orgId], references: [id])
  userId   String
  user     User     @relation(fields: [userId], references: [id])

  @@unique([orgId, userId])
}

model Scan {
  id               String    @id @default(cuid())
  repoUrl          String
  repoName         String
  repoOwner        String
  branch           String    @default("main")
  builderMetadata  String?   // JSON string — Mutly build source info for SQLite
  status           String    @default("pending")
  progress         Int       @default(0)
  message          String?
  overallScore     Int?
  gradeCategory    String?
  maturityLevel    String?
  vibeScore        Int?
  report           String?  // JSON string for SQLite compatibility
  complianceReport String?  // JSON string for SQLite compatibility
  fixPack          String?  // JSON string for SQLite compatibility
  clawFindings     String?  // JSON string for SQLite compatibility
  errorMessage     String?
  duration         Int?
  createdAt        DateTime  @default(now())
  completedAt      DateTime?
  userId           String
  user             User      @relation(fields: [userId], references: [id])
  orgId            String?
  org              Org?      @relation(fields: [orgId], references: [id])
  projectBriefId   String?
  projectBrief     ProjectBrief? @relation(fields: [projectBriefId], references: [id])

  @@index([orgId])
  @@index([userId])
  @@index([repoUrl])
  @@index([status])
  @@index([projectBriefId])
}

model ApiKey {
  id         String    @id @default(cuid())
  keyPrefix  String
  keyHash    String    @unique
  name       String
  tier       String    @default("free")
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
}

model ClawAgent {
  id         String      @id @default(cuid())
  name       String
  type       String
  config     String?  // JSON string for SQLite compatibility
  trustScore Int         @default(100)
  status     String      @default("active")
  createdAt  DateTime    @default(now())
  orgId      String
  org        Org         @relation(fields: [orgId], references: [id])
  alerts     ClawAlert[]
}

model ClawAlert {
  id           String      @id @default(cuid())
  module       String
  severity     String
  title        String
  description  String?
  raw          String?  // JSON string for SQLite compatibility
  acknowledged Boolean     @default(false)
  createdAt    DateTime    @default(now())
  orgId        String
  org          Org         @relation(fields: [orgId], references: [id])
  agentId      String?
  agent        ClawAgent?  @relation(fields: [agentId], references: [id])

  @@index([orgId])
  @@index([severity])
}

model Subscription {
  id                   String    @id @default(cuid())
  stripeSubscriptionId String    @unique
  plan                 String
  status               String
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  createdAt            DateTime  @default(now())
  orgId                String
  org                  Org       @relation(fields: [orgId], references: [id])
}

model Webhook {
  id        String   @id @default(cuid())
  url       String
  events    String   // JSON array string for SQLite compatibility
  secret    String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  orgId     String
  org       Org      @relation(fields: [orgId], references: [id])
}
model PrWebhookConfig {
  id                String    @id @default(cuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id])
  repoFullName      String
  githubToken       String?
  orgId             String?
  enabled           Boolean   @default(true)
  minScoreThreshold Int       @default(60)
  commentOn         String   // JSON array string for SQLite compatibility
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  events            PrEvent[]

  @@unique([userId, repoFullName])
  @@index([repoFullName])
}

model PrEvent {
  id        String          @id @default(cuid())
  configId  String
  config    PrWebhookConfig @relation(fields: [configId], references: [id])
  prNumber  Int
  prTitle   String
  headSha   String
  baseRef   String
  action    String
  status    String          @default("pending")
  createdAt DateTime        @default(now())
  commentId String?
  scoreBefore Int?
  scoreAfter  Int?
  headScanId  String?
  baseScore   Int?

  @@index([configId])
  @@index([status])
}

model ProjectBrief {
  id                 String              @id @default(cuid())
  name               String
  repoUrl            String?
  buildSource        String              @default("github")
  objective          String
  targetUsers        String?
  deliverables       String              // JSON string for SQLite compatibility
  exclusions         String              // JSON string for SQLite compatibility
  constraints        String              @default("[]") // JSON string for SQLite compatibility
  assumptions        String              @default("[]") // JSON string for SQLite compatibility
  acceptanceCriteria String              // JSON string for SQLite compatibility
  deadline           DateTime?
  timebox            String?
  status             String              @default("pending")
  intentDocument     String?             // JSON string for SQLite compatibility
  createdAt          DateTime            @default(now())
  userId             String
  user               User                @relation(fields: [userId], references: [id])
  orgId              String?
  org                Org?                @relation(fields: [orgId], references: [id])
  approvals          BriefApproval[]
  milestones         Milestone[]
  changeRequests     ScopeChangeRequest[]
  scans              Scan[]

  @@index([userId])
  @@index([orgId])
  @@index([status])
}

model Milestone {
  id                         String       @id @default(cuid())
  name                       String
  type                       String       @default("feature-complete")
  targetDate                 DateTime?
  goal                       String?
  acceptanceCriteriaSnapshot String       @default("[]") // JSON string for SQLite compatibility
  status                     String       @default("pending")
  createdAt                  DateTime     @default(now())
  scanId                     String?
  projectId                  String
  brief                      ProjectBrief @relation(fields: [projectId], references: [id])
  gates                      AcceptanceGate[]

  @@index([projectId])
}

model AcceptanceGate {
  id             String    @id @default(cuid())
  milestoneId    String
  milestone      Milestone @relation(fields: [milestoneId], references: [id])
  projectId      String?
  criterion      String
  type           String
  status         String    @default("pending")
  evidence       String?
  overrideReason String?
  approvedBy     String?
  createdAt      DateTime  @default(now())

  @@index([milestoneId])
}

model ScopeChangeRequest {
  id              String       @id @default(cuid())
  projectId       String
  brief           ProjectBrief @relation(fields: [projectId], references: [id])
  title           String
  description     String       @default("")
  reason          String       @default("")
  requestedBy     String
  impactTime      String?
  impactComplexity String?
  impactCost      String?
  approvedBy      String?
  oldScope        String       // JSON string for SQLite compatibility
  newScope        String       // JSON string for SQLite compatibility
  status          String       @default("pending")
  createdAt       DateTime     @default(now())

  @@index([projectId])
}

model BriefApproval {
  id             String       @id @default(cuid())
  projectBriefId String
  projectBrief   ProjectBrief @relation(fields: [projectBriefId], references: [id])
  approvedBy     String
  version        Int
  notes          String?
  approvedAt     DateTime     @default(now())

  @@index([projectBriefId])
}

model AgentsFileVersion {
  id              String   @id @default(cuid())
  userId          String
  repoFullName    String
  mode            String
  content         String
  contentHash     String
  estimatedTokens Int
  ruleCount       Int
  generatedBy     String
  scanId          String?
  createdAt       DateTime @default(now())

  @@unique([userId, repoFullName, contentHash])
  @@index([userId, repoFullName])
}

model Course {
  id           String       @id @default(cuid())
  name         String
  slug         String       @unique
  description  String?
  lmsType      String       @default("custom")
  lmsCourseId  String?
  instructorId String
  createdAt    DateTime     @default(now())
  assignments  Assignment[]
}

model Assignment {
  id          String              @id @default(cuid())
  courseId    String
  course      Course              @relation(fields: [courseId], references: [id])
  title       String
  description String?
  language    String              @default("typescript")
  guidelines  String              @default("[]") // JSON string for SQLite compatibility
  rubric      String?             // JSON string for SQLite compatibility
  dueAt       DateTime?
  createdAt   DateTime            @default(now())
  submissions StudentSubmission[]
}

model StudentSubmission {
  id               String     @id @default(cuid())
  assignmentId     String
  assignment       Assignment @relation(fields: [assignmentId], references: [id])
  studentEmail     String
  studentName      String?
  repoUrl          String?
  sourceFiles      String     // JSON string for SQLite compatibility
  session          String?    // JSON string for SQLite compatibility
  auditReport      String?    // JSON string for SQLite compatibility
  sessionAnalysis  String?    // JSON string for SQLite compatibility
  overallScore     Int?
  overallGrade     String?
  aiContamination  Int?
  submittedAt      DateTime   @default(now())

  @@index([assignmentId])
  @@index([studentEmail])
}



