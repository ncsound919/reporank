# RepoRank API — environment
DATABASE_URL=postgresql://user:pass@127.0.0.1:5432/reporank
REDIS_URL=redis://127.0.0.1:6379
JWT_SECRET=
# Gemini stays as the default AI-grading path (routed through the fleet chain,
# which prefers the LiteLLM gateway when LITELLM_MASTER_KEY is set).
GEMINI_API_KEY=

# ========== Fleet LiteLLM seam (AI grading) ==========
# The grading-engine's LLM call goes through @overlay365/fleet-client, which
# prefers the LiteLLM gateway when this key is present. Provider groups rotate
# inside LiteLLM. Set LOCAL_AI_PROVIDER=litellm (or pass aiProvider:"litellm"
# to a scan) to use the explicit LiteLLM provider instead of Gemini.
LITELLM_MASTER_KEY=
LOCAL_AI_PROVIDER=gemini
# Model group used by the explicit LiteLLM provider (default: opencode).
LITELLM_AUDIT_MODEL=opencode

# ========== Jev (System One) grade advisory ==========
# Typed choice/noul/score advisory over the deterministic score, attached to the
# scan report as `report.jev`. Advisory only. Two-tier: Vercel AI Gateway
# TypeSafe lane (key below) → LocalJev :8080. Set REPORANK_JEV=0 to disable.
TYPESAFE_BASE_URL=https://ai-gateway.vercel.sh/typesafe
TYPESAFE_API_KEY=
TYPESAFE_MODEL=typesafe-ai/jev
AI_GATEWAY_API_KEY=
JEV_LOCAL_BASE_URL=http://127.0.0.1:8080
JEV_LOCAL_MODEL=jev-latest
JEV_TIMEOUT_MS=10000
REPORANK_JEV=1
